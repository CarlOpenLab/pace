CREATE TABLE categories (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    sortOrder INTEGER NOT NULL,
    usageCount INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX categories_name ON categories(name);

selectAllCategories:
SELECT * FROM categories ORDER BY sortOrder, name;

selectCategoryByName:
SELECT * FROM categories WHERE name = ?;

selectCategoryById:
SELECT * FROM categories WHERE id = ?;

insertOrReplaceCategory:
INSERT OR REPLACE INTO categories(id, name, kind, sortOrder, usageCount) VALUES (?, ?, ?, ?, ?);

incrementCategoryUsage:
UPDATE categories SET usageCount = usageCount + 1 WHERE name = ?;

deleteAllCategories:
DELETE FROM categories;

countAllCategories:
SELECT COUNT(*) AS total FROM categories;
